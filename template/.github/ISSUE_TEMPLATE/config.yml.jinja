blank_issues_enabled: false
contact_links:
  - name: Report a security vulnerability
    url: https://github.com/{{ github_username }}/{{ project_slug }}/security/advisories/new
    about: Report security vulnerabilities privately. Do not open a public issue.
  - name: Question or Discussion
    url: https://github.com/{{ github_username }}/{{ project_slug }}/discussions
    about: Please use GitHub Discussions for questions and general discussions
  - name: Documentation
    url: https://{{ project_slug }}.readthedocs.io/
    about: Check the documentation for guides and API references
